
config interface 'loopback'
	option ifname 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option ifname 'eth0.1'
	option type 'bridge'
	option proto 'static'
	option ipaddr '192.168.0.254'
	option netmask '255.255.255.0'
	option macaddr 'FF:FF:FF:FF:FF:FF'

config interface 'wan'
	option ifname 'eth0.2'
	option proto 'dhcp'
	option macaddr 'FF:FF:FF:FF:FF:FF'
	option dmtu '1500'
	option smtu '1500'
	option pmtu '1492'
 	option mtu '1500'
	option hostname 'TOTOLINK'
	option peerdns '1'
	option dns	''
	option ppp_spectype '0'

config switch
	option name 'switch0'
	option reset '1'
	option enable_vlan '1'
			
config switch_vlan
	option device 'switch0'
	option vlan '1'
	option ports '0t 1 2 3 4'
			
config switch_vlan
	option device 'switch0'
	option vlan '2'
	option ports '0t 5'
        
