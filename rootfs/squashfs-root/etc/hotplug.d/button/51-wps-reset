#echo button,wps and reset,$ACTION,$BUTTON,$SEEN > /dev/console

. /lib/totolink_custom.sh

if [ "$GPIO_BTN_TYPE" = "different" -a "$ACTION" = "reset" -a "$BUTTON" = "reset" ]; then
	echo "" > /dev/console
	echo "RESET TO FACTORY LED EVENT DETECTED" > /dev/console
	cs reset
fi

if [ "$GPIO_BTN_TYPE" = "different" -a "$ACTION" = "released" -a "$BUTTON" = "reset" ]; then
	if [ "$SEEN" -ge 5 ]; then
		echo 100000 >/sys/class/leds/ap147\:green\:status/delay_on
		echo "REBOOT EVENT DETECTED" > /dev/console
		reboot
	fi
fi

if [ "$GPIO_BTN_TYPE" = "multiplexing" -a "$ACTION" = "reset" -a "$BUTTON" = "wps" ]; then
	echo "" > /dev/console
	echo "RESET TO FACTORY SETTING EVENT DETECTED" > /dev/console
	cs reset
fi

if [ "$GPIO_BTN_TYPE" = "multiplexing" -a "$ACTION" = "released" -a "$BUTTON" = "wps" ]; then
	if [ "$SEEN" -ge 5 ]; then
		echo "" > /dev/console
		echo 100000 >/sys/class/leds/ap147\:blue\:system/delay_on
		echo "RESET TO FACTORY SETTING EVENT DETECTED" > /dev/console
		reboot
	fi
fi


